# Copy to .env in this folder (gitignored) and fill in:
#   docker compose up -d

# The hostname pointed at this box. With no DNS name, <ip with dashes>.sslip.io
# resolves to the IP (3-14-15-92.sslip.io), and Let's Encrypt issues for it.
STRUT_VOICE_HOST=voice.example.com

# Each `openssl rand -hex 32`.
STRUT_API_KEY=
STRUT_SECRET_KEY=
STRUT_VOICE_TOKEN=

# The orchestrator's model calls.
ANTHROPIC_API_KEY=

# A key pair on the central LiveKit (wss://livekit.sphinx.chat). Prefer one
# made for this box over the swarms' shared pair: this box holds it.
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Optional:
# LIVEKIT_URL=wss://livekit.sphinx.chat
# VOICE_MODEL=haiku            # the model a voice turn asks for
# STRUT_TTS_VOICE=af_heart     # the voice a call starts in
# STRUT_IMAGE_TAG=latest       # a short commit sha pins one
# SPHINX_VOICE_TAG=latest
# CADDY_TAG=2
# VOICE_HTTP_PORT=80
# VOICE_HTTPS_PORT=443
