# Copy to .env in this folder (gitignored) and fill in:
#   docker compose up -d
# Every line here reaches the strut container.

# The package this box serves (plans/app-repos.md §4.1): a git repository's
# branch (git+https://host/org/repo@<branch|tag|commit>, #<folder> when the
# package is in one), a name the indexes strut follows list
# (acme/moonlander), a pk: ref with its catalog URL, or a file: path the
# compose file mounts. The package carries a serve.yaml.
STRUT_SERVE=git+https://github.com/acme/moonlander@main
# A pk: ref's catalog instead: the publisher strut's public catalog.
# STRUT_SERVE=pk:<publisher's public key>/acme/moonlander
# STRUT_SERVE_URL=https://publisher.example.com/packages/catalog?public=1

# A private repository: a token that can read it, in GITHUB_TOKEN, or in the
# secret STRUT_SERVE_TOKEN_SECRET names. A public one needs neither.
# GITHUB_TOKEN=
# STRUT_SERVE_TOKEN_SECRET=MOONLANDER_TOKEN

# The domain, pointed at this box. app.localhost for a local try.
STRUT_APP_HOST=moonlander.example.com

# The operator's key: /?shell=1, GET /serve. `openssl rand -hex 32`
STRUT_API_KEY=
# Seals the encrypted files (secrets, the wallet). `openssl rand -hex 32`.
# Back it up somewhere other than the data volume.
STRUT_SECRET_KEY=

# What the package's workflows call: a model key, and the values its
# strut.yaml lists under requires.secrets (the deploy log names any missing).
# ANTHROPIC_API_KEY=

# The wallet, when serve.yaml prices a workflow (specs/LIGHTNING.md):
# LIGHTNING_NWC_URL=nostr+walletconnect://…
# or LIGHTNING_DAEMON_URL= with LIGHTNING_DAEMON_TOKEN=

# Optional:
# STRUT_SERVE_POLL_MINUTES=5     # how often a git+ ref is fetched; 0 = at boot and on POST /serve/sync only
# STRUT_DISTRO_POLL_MINUTES=10   # how often any other ref is read again; 0 = at boot only
# STRUT_PEER_KEY=                # lets the publisher's strut ping a new release here at once
# STRUT_IMAGE_TAG=latest         # a short commit sha pins one
# CADDY_TAG=2
# APP_HTTP_PORT=80
# APP_HTTPS_PORT=443
