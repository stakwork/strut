# Copy to .env in this folder (gitignored) and fill in:
#   docker compose up -d

# Both hostnames point at this box. *.localhost for a local try.
STRUT_INDEX_HOST=index.example.com
PKARR_RELAY_HOST=relay.example.com

# The operator's key for the index strut (rows, crawl). `openssl rand -hex 32`
STRUT_API_KEY=
# Seals publisher.json, which holds the index key. `openssl rand -hex 32`.
# Back it up somewhere other than the data volume.
STRUT_SECRET_KEY=

# Optional:
# STRUT_IMAGE_TAG=latest      # a short commit sha pins one
# PKARR_RELAY_TAG=v8.1.0
# CADDY_TAG=2
# INDEX_HTTP_PORT=80
# INDEX_HTTPS_PORT=443
# PKARR_DHT_PORT=6881
