{
  "name": "@strut/kit",
  "version": "0.1.0",
  "description": "The app kit for strut apps (plans/apps.md \u00a73): the frozen vendor layer every app build resolves against, the base stylesheet, the bootstrap and the hooks over one tool, step_run.",
  "type": "module",
  "license": "MIT",
  "files": [
    "dist",
    "vendor",
    "src/styles"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bootstrap": {
      "types": "./dist/bootstrap.d.ts",
      "import": "./dist/bootstrap.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "import": "./dist/node.js"
    },
    "./styles/base.css": "./src/styles/base.css",
    "./vendor/*": "./vendor/*",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsx scripts/build-vendor.ts && tsx scripts/build-lib.ts",
    "build:vendor": "tsx scripts/build-vendor.ts",
    "build:lib": "tsx scripts/build-lib.ts",
    "shadcn": "shadcn add --all --overwrite --yes",
    "test": "tsx --test src/*.test.ts"
  },
  "peerDependencies": {
    "@tanstack/react-query": "5.104.5",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    }
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "2.0.3",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@happy-dom/global-registrator": "21.0.4",
    "@hookform/resolvers": "6.0.0",
    "@modelcontextprotocol/client": "2.3.1",
    "@modelcontextprotocol/core": "2.3.1",
    "@tanstack/react-query": "5.104.5",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.21",
    "@types/d3": "7.4.3",
    "@types/lodash": "4.17.27",
    "@types/node": "22.19.0",
    "@types/papaparse": "5.5.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@xyflow/react": "12.12.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "d3": "7.9.0",
    "date-fns": "4.4.0",
    "esbuild": "0.28.2",
    "fuse.js": "7.5.0",
    "happy-dom": "21.0.4",
    "immer": "11.2.7",
    "lodash": "4.18.1",
    "lucide-react": "1.61.0",
    "mathjs": "15.2.0",
    "motion": "14.5.0",
    "papaparse": "5.7.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-is": "19.3.1",
    "react-markdown": "10.1.0",
    "react-resizable-panels": "4.14.8",
    "react-router": "8.5.0",
    "recharts": "3.8.0",
    "remark-gfm": "4.0.1",
    "shadcn": "4.22.1",
    "simple-statistics": "7.12.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vaul": "1.1.2",
    "zod": "4.6.7",
    "zustand": "5.0.15"
  },
  "engines": {
    "node": ">=22"
  }
}
