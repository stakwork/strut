{
  "name": "strut",
  "version": "0.1.0",
  "description": "Minimal, LLM-friendly workflow engine",
  "type": "module",
  "private": true,
  "main": "./build/index.js",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "types": "./build/index.d.ts",
      "import": "./build/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "build",
    "web/dist",
    "kit/vendor",
    "kit/src/styles/base.css"
  ],
  "scripts": {
    "build": "npm run build:engine && npm run build:kit",
    "build:engine": "tsc && node -e \"fs.cpSync('src/workflows', 'build/workflows', { recursive: true }); fs.cpSync('src/concepts', 'build/concepts', { recursive: true }); fs.cpSync('src/apps/templates', 'build/apps/templates', { recursive: true }); fs.cpSync('src/apps/views', 'build/apps/views', { recursive: true }); fs.cpSync('src/apps/jamie', 'build/apps/jamie', { recursive: true }); fs.cpSync('src/apps/knowledge', 'build/apps/knowledge', { recursive: true }); fs.cpSync('src/apps/earnings', 'build/apps/earnings', { recursive: true }); fs.cpSync('src/apps/staff', 'build/apps/staff', { recursive: true })\"",
    "build:kit": "node scripts/build-kit.mjs",
    "build:aieo": "npm --prefix aieo run build",
    "prepare": "npm run build && npm --prefix web install && npm --prefix web run build",
    "build:web": "npm --prefix web run build",
    "package:desktop": "node scripts/package-desktop.mjs",
    "dev": "npm run build:web && tsx --env-file=.env src/server.ts",
    "start": "node build/server.js",
    "test": "STRUT_PACKAGE_INDEXES='[]' tsx --test ${STRUT_TEST_SHARD:+--test-shard=$STRUT_TEST_SHARD} \"src/**/*.test.ts\" \"kit/src/**/*.test.ts\" \"web/src/**/*.test.ts\" \"scripts/*.test.mjs\"",
    "test:stt": "STRUT_TEST_STT=1 tsx --test src/audio/stt.live.test.ts",
    "test:stt:parakeet": "STRUT_TEST_STT=1 STRUT_TEST_STT_PARAKEET=1 tsx --test src/audio/stt.live.test.ts",
    "test:tts": "STRUT_TEST_TTS=1 tsx --test src/audio/tts.live.test.ts",
    "test:image": "STRUT_TEST_IMAGE=1 tsx --test src/steps/core/image.live.test.ts",
    "eval:dictation": "tsx src/audio/dictation-eval/run.ts",
    "check:fixer": "tsc -p fixer/tsconfig.json",
    "test:privacy": "STRUT_PRIVACY_LIVE=1 tsx --test src/privacy/privacy.live.test.ts",
    "test:browser": "tsx --test src/browser/service.live.test.ts",
    "test:app-look": "STRUT_TEST_APP_LOOK=1 tsx --test src/apps/look.live.test.ts",
    "test:gateway": "tsx scripts/gateway-smoke.ts",
    "bench:memory-graph": "tsx scripts/bench-memory-graph.ts",
    "test:graph": "node scripts/test-graph.mjs",
    "test:app-build": "node scripts/check-app-build.mjs"
  },
  "dependencies": {
    "@ai-sdk/google": "4.0.74",
    "@ai-sdk/openai": "4.0.69",
    "@ai-sdk/provider-utils": "^5.0.44",
    "@ai-sdk/typesafe-ai": "^3.0.3",
    "@ai-sdk/xai": "5.0.2",
    "@googleapis/drive": "^20.2.0",
    "@hono/node-server": "^2.0.4",
    "@huggingface/transformers": "^4.1.0",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@noble/curves": "^1.6.0",
    "@octokit/rest": "^22.0.1",
    "@openrouter/ai-sdk-provider": "3.0.0",
    "esbuild": "0.28.2",
    "gatekey": "^0.1.1",
    "hono": "^4.12.23",
    "html-to-text": "^10.0.1",
    "js-yaml": "^4.1.1",
    "neo4j-driver": "^5.28.3",
    "playwright-core": "1.64.1",
    "qrcode-generator": "2.0.4",
    "sharp": "^0.35.5",
    "system-canvas": "^0.2.22",
    "system-canvas-react": "^0.2.22",
    "tailwindcss": "4.3.3",
    "undici": "^7.29.0",
    "uuid": "^11.1.0",
    "word-extractor": "^1.0.4",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@ai-sdk/anthropic": "4.0.71",
    "@types/html-to-text": "^9.0.4",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.19.0",
    "@types/uuid": "^10.0.0",
    "@types/word-extractor": "^1.0.6",
    "@types/ws": "^8.18.1",
    "ai": "^7.0.106",
    "tsx": "^4.21.0",
    "typescript": "^5.9.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "@ai-sdk/anthropic": "^4.0.71",
    "ai": "^7.0.106",
    "zod": "^4.3.6"
  },
  "optionalDependencies": {
    "@ladybugdb/core": "^0.21.2",
    "sherpa-onnx-node": "^1.13.7"
  },
  "resolutions": {
    "sharp": "0.35.5"
  },
  "overrides": {
    "sharp": "0.35.5"
  },
  "engines": {
    "node": ">=22.13"
  }
}
